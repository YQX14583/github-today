[Unit]
Description=GitHub Today Next.js application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=github-today
Group=github-today
WorkingDirectory=/opt/github-today
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
